# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis na Vercel (produção).
# No Supabase: botão "Connect" (ou Project Settings > Database) > Connection string.

# Usada pelo site: "Transaction pooler" (porta 6543).
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Usada pelas migrações do Prisma: "Session pooler" (porta 5432) ou a conexão direta.
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Senha inicial do admin geral (admin@cidade10.com) criada pelo `npm run db:seed`.
ADMIN_PASSWORD=troque-esta-senha

# Contas de teste (teste1, cidade1, barbearia1... senha 1234). Use 0 para desligar antes de divulgar o site.
TEST_ACCOUNTS=1

# Fuso das datas e horários (padrão America/Sao_Paulo).
# APP_TIME_ZONE=America/Sao_Paulo
